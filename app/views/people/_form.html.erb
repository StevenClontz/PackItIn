<% input_class = "block w-full rounded-md border border-gray-300 px-3 py-2" %>
<% url = person.persisted? ? person_path(person) : family_people_path(family) %>

<%= form_with(model: person, url: url) do |f| %>
  <%= render "devise/shared/error_messages", resource: person %>

  <div class="mb-4">
    <%= f.label :first_name, class: "mb-1 block font-medium" %>
    <%= f.text_field :first_name, autofocus: true, class: input_class %>
  </div>

  <div class="mb-4">
    <%= f.label :last_name, class: "mb-1 block font-medium" %>
    <%= f.text_field :last_name, class: input_class %>
  </div>

  <div class="mb-4">
    <%= f.label :den, class: "mb-1 block font-medium" %>
    <%= f.select :den, Person.den_options, { prompt: "Select a den" }, class: input_class %>
  </div>

  <div class="mb-4">
    <%= f.label :email, class: "mb-1 block font-medium" %>
    <%= f.email_field :email, autocomplete: "email", class: input_class %>
  </div>

  <div class="mb-4">
    <%= f.label :phone_number, "Phone number", class: "mb-1 block font-medium" %>
    <%= f.telephone_field :phone_number, autocomplete: "tel", class: input_class %>
  </div>

  <div class="mb-4">
    <%= f.label :scouting_america_id, "Scouting America ID", class: "mb-1 block font-medium" %>
    <%= f.text_field :scouting_america_id, class: input_class %>
  </div>

  <%= f.submit class: "rounded-md bg-blue-600 px-4 py-2 font-medium text-white hover:bg-blue-500 cursor-pointer" %>
<% end %>
