<div class="mx-auto w-full max-w-md">
  <h2 class="mb-6 flex flex-wrap items-center gap-3 text-2xl font-bold">
    <%= @person.full_name %>
    <%= den_badge(@person) %>
  </h2>

  <dl class="mb-6 grid grid-cols-[auto_1fr] gap-x-6 gap-y-2">
    <dt class="font-medium">First name</dt>
    <dd><%= @person.first_name %></dd>
    <dt class="font-medium">Last name</dt>
    <dd><%= @person.last_name %></dd>
    <dt class="font-medium">Den</dt>
    <dd><%= @person.den_label %></dd>
    <dt class="font-medium">Email</dt>
    <dd><%= @person.email.presence || "—" %></dd>
    <dt class="font-medium">Phone number</dt>
    <dd><%= @person.formatted_phone_number || "—" %></dd>
    <dt class="font-medium">Scouting America ID</dt>
    <dd><%= @person.scouting_america_id.presence || "—" %></dd>
    <dt class="font-medium">Family</dt>
    <dd><%= link_to @family.username, family_path(@family), class: "text-blue-600 hover:underline" %></dd>
  </dl>

  <div class="flex items-center gap-4">
    <% if can? :update, @person %>
      <%= link_to "Edit", edit_person_path(@person), class: "text-blue-600 hover:underline" %>
    <% end %>
    <% if can? :destroy, @person %>
      <%= button_to "Delete", person_path(@person), method: :delete, data: { turbo_confirm: "Delete #{@person.full_name}? This cannot be undone." }, class: "text-red-600 hover:underline cursor-pointer" %>
    <% end %>
  </div>

  <p class="mt-6 text-sm"><%= link_to "Back to family", family_path(@family), class: "text-blue-600 hover:underline" %></p>
</div>
