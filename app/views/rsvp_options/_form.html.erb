<% input_class = "block w-full rounded-md border border-gray-300 px-3 py-2" %>

<%= form_with(model: [ event, rsvp_option ]) do |f| %>
  <%= render "devise/shared/error_messages", resource: rsvp_option %>

  <div class="mb-4">
    <%= f.label :name, class: "mb-1 block font-medium" %>
    <%= f.text_field :name, autofocus: true, placeholder: "Full weekend", class: input_class %>
  </div>

  <div class="mb-4">
    <%= f.label :cost_dollars, "Cost (dollars)", class: "mb-1 block font-medium" %>
    <p class="mb-1 text-sm text-gray-500">Optional. Per person (per adult, if a youth cost is set). Leave blank if free.</p>
    <%= f.text_field :cost_dollars, inputmode: "decimal", placeholder: "25.00", autocomplete: "off", class: input_class %>
  </div>

  <div class="mb-4">
    <%= f.label :youth_cost_dollars, "Youth cost (dollars)", class: "mb-1 block font-medium" %>
    <p class="mb-1 text-sm text-gray-500">Optional. Charged for anyone who isn't an adult (lion, tiger, wolf, bear, webelos, AOL, youth). Leave blank to charge everyone the cost above.</p>
    <%= f.text_field :youth_cost_dollars, inputmode: "decimal", placeholder: "15.00", autocomplete: "off", class: input_class %>
  </div>

  <div class="mb-4">
    <%= f.label :description, class: "mb-1 block font-medium" %>
    <p class="mb-1 text-sm text-gray-500">Optional. Shown to families choosing between options.</p>
    <%= f.text_area :description, rows: 3, class: input_class %>
  </div>

  <%= f.submit class: "rounded-md bg-blue-600 px-4 py-2 font-medium text-white hover:bg-blue-500 cursor-pointer" %>
<% end %>
