<%= render "footer" %>
<p style="margin: 0 0 16px;">RSVPs for <strong><%= @event.title %></strong> (<%= event_time_range(@event) %>) close <strong><%= format_event_time(@event.rsvp_closes_at) %></strong>.</p>

<p style="margin: 0 0 8px;">Still waiting to hear about:</p>
<ul style="margin: 0 0 16px; padding-left: 20px;">
  <% @payment.blockers.each do |blocker| %>
    <li><%= blocker %></li>
  <% end %>
</ul>

<p style="margin: 0;"><%= link_to "RSVP now", event_url(@event), style: "display: inline-block; padding: 10px 16px; background: #2563eb; color: #ffffff; border-radius: 6px; text-decoration: none; font-weight: bold;" %></p>
