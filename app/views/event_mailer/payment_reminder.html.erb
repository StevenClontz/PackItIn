<%= render "footer" %>
<p style="margin: 0 0 16px;"><%= @person.family.name %> has <strong><%= @payment.outstanding.format %></strong> due for <strong><%= @event.title %></strong> (<%= event_time_range(@event) %>).</p>

<table style="margin: 0 0 16px; border-collapse: collapse;">
  <% @payment.line_items.each do |item| %>
    <tr>
      <td style="padding: 2px 16px 2px 0;"><%= item.person.full_name %> - <%= item.option.name %></td>
      <td style="padding: 2px 0; text-align: right;"><%= item.cost.format %></td>
    </tr>
  <% end %>
  <% unless @payment.paid.zero? %>
    <tr>
      <td style="padding: 2px 16px 2px 0;">Already paid</td>
      <td style="padding: 2px 0; text-align: right;">-<%= @payment.paid.format %></td>
    </tr>
  <% end %>
</table>

<p style="margin: 0 0 16px;">Pay from your Scout Account on the event page. Your Scout Account balance is <%= @person.family.balance.format %>.</p>
<p style="margin: 0;"><%= link_to "Pay now", event_url(@event), style: "display: inline-block; padding: 10px 16px; background: #2563eb; color: #ffffff; border-radius: 6px; text-decoration: none; font-weight: bold;" %></p>
