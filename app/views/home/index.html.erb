<div class="w-full max-w-md mx-auto text-center">
  <h1 class="font-bold text-4xl mb-4">Pack It In</h1>
  <% if family_signed_in? %>
    <p class="mb-6 text-gray-700">Signed in as <strong><%= current_family.username %></strong>.</p>
    <div class="flex justify-center gap-4">
      <%= link_to "Events", events_path, class: "text-blue-600 hover:underline" %>
      <% if current_family.admin? %>
        <%= link_to "Families", families_path, class: "text-blue-600 hover:underline" %>
      <% end %>
      <% if can? :index, Fund %>
        <%= link_to "Funds", funds_path, class: "text-blue-600 hover:underline" %>
      <% end %>
      <%= link_to "Our Scout Account", family_account_path(current_family), class: "text-blue-600 hover:underline" %>
      <%= link_to "Manage our family", family_path(current_family), class: "text-blue-600 hover:underline" %>
      <%= button_to "Log out", destroy_family_session_path, method: :delete, class: "text-blue-600 hover:underline cursor-pointer" %>
    </div>
  <% else %>
    <p class="mb-6 text-gray-700">Managing a Cub Scout pack, one family at a time.</p>
    <div class="flex justify-center gap-4">
      <%= link_to "Log in", new_family_session_path, class: "rounded-md bg-blue-600 px-4 py-2 font-medium text-white hover:bg-blue-500" %>
    </div>
  <% end %>
</div>
