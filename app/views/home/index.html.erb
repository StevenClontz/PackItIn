<div class="w-full max-w-md mx-auto text-center">
  <h1 class="font-bold text-4xl mb-4">Pack It In</h1>
  <p class="text-gray-700">
    <% if family_signed_in? %>
      Signed in as <strong><%= current_family.username %></strong>.
    <% end %>
  </p>

  <% if @upcoming_events.any? %>
    <h2 class="mb-2 mt-8 text-left text-lg font-semibold">Upcoming Events</h2>
    <ul class="divide-y divide-gray-200 rounded-md border border-gray-200 text-left">
      <% @upcoming_events.each do |event| %>
        <li class="flex flex-wrap items-center justify-between gap-2 px-4 py-3">
          <span>
            <%= link_to event.title, event_path(event), class: "font-medium text-blue-600 hover:underline" %>
            <span class="block text-sm text-gray-500"><%= event_time_range(event) %></span>
          </span>
        </li>
      <% end %>
    </ul>
    <p class="mt-3 text-left text-sm"><%= link_to "View all events", events_path, class: "text-blue-600 hover:underline" %></p>
  <% end %>
</div>
