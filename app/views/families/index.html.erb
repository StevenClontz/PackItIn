<div class="mx-auto w-full max-w-2xl">
  <div class="mb-6 flex items-center justify-between">
    <h2 class="text-2xl font-bold">Families</h2>
    <% if can? :create, Family %>
      <%= link_to "New family", new_family_path, class: "rounded-md bg-blue-600 px-4 py-2 font-medium text-white hover:bg-blue-500" %>
    <% end %>
  </div>

  <ul class="divide-y divide-gray-200 rounded-md border border-gray-200">
    <% @families.each do |family| %>
      <li class="flex flex-wrap items-center justify-between gap-2 px-4 py-3">
        <span class="flex items-center gap-2">
          <%= link_to family.name, family_path(family), class: "font-medium text-blue-600 hover:underline" %>
          <% if family.admin? %>
            <span class="rounded-full bg-gray-100 px-2 py-0.5 text-xs font-medium text-gray-700">Admin</span>
          <% end %>
        </span>
        <span class="flex items-center gap-4 text-sm">
          <% if can? :update, family %>
            <%= link_to "Edit", edit_family_path(family), class: "text-blue-600 hover:underline" %>
          <% end %>
          <% if can? :destroy, family %>
            <%= button_to "Delete", family_path(family), method: :delete, data: { turbo_confirm: "Delete #{family.username}? This cannot be undone." }, class: "text-red-600 hover:underline cursor-pointer" %>
          <% end %>
        </span>
      </li>
    <% end %>
  </ul>

  <p class="mt-6 text-sm"><%= link_to "Back", root_path, class: "text-blue-600 hover:underline" %></p>
</div>
