<div class="mx-auto w-full max-w-md">
  <h2 class="mb-6 text-2xl font-bold"><%= @family.name %></h2>

  <dl class="mb-6 grid grid-cols-[auto_1fr] gap-x-6 gap-y-2">
    <dt class="font-medium">Username</dt>
    <dd><%= @family.username %></dd>
    <dt class="font-medium">Name</dt>
    <dd><%= @family.name %></dd>
    <dt class="font-medium">Address</dt>
    <dd>
      <%= @family.street_address %><br>
      <%= @family.city %>, <%= @family.state_label %> <%= @family.zip %>
    </dd>
    <% if can? :view_account, @family %>
      <dt class="font-medium">Scout Account</dt>
      <dd><%= link_to money(@family.balance), family_account_path(@family), class: "hover:underline" %></dd>
    <% end %>
    <dt class="font-medium">Administrator</dt>
    <dd><%= @family.admin? ? "Yes" : "No" %></dd>
  </dl>

  <div class="flex items-center gap-4">
    <% if can? :update, @family %>
      <%= link_to "Edit", edit_family_path(@family), class: "text-blue-600 hover:underline" %>
    <% end %>
    <% if can? :destroy, @family %>
      <%= button_to "Delete", family_path(@family), method: :delete, data: { turbo_confirm: "Delete #{@family.username}? This cannot be undone." }, class: "text-red-600 hover:underline cursor-pointer" %>
    <% end %>
  </div>

  <div class="mb-6 mt-8 flex items-center justify-between">
    <h3 class="text-xl font-bold">People</h3>
    <% if can? :create, Person.new(family: @family) %>
      <%= link_to "Add person", new_family_person_path(@family), class: "rounded-md bg-blue-600 px-4 py-2 font-medium text-white hover:bg-blue-500" %>
    <% end %>
  </div>

  <% if @people.empty? %>
    <p class="text-gray-700">No people yet.</p>
  <% else %>
    <ul class="divide-y divide-gray-200 rounded-md border border-gray-200">
      <% @people.each do |person| %>
        <li class="flex flex-wrap items-center justify-between gap-2 px-4 py-3">
          <span class="flex items-center gap-2">
            <%= link_to person.full_name, person_path(person), class: "font-medium text-blue-600 hover:underline" %>
            <%= den_badge(person) %>
          </span>
          <span class="flex items-center gap-4 text-sm">
            <% if can? :update, person %>
              <%= link_to "Edit", edit_person_path(person), class: "text-blue-600 hover:underline" %>
            <% end %>
            <% if can? :destroy, person %>
              <%= button_to "Delete", person_path(person), method: :delete, data: { turbo_confirm: "Delete #{person.full_name}? This cannot be undone." }, class: "text-red-600 hover:underline cursor-pointer" %>
            <% end %>
          </span>
        </li>
      <% end %>
    </ul>
  <% end %>

  <p class="mt-6 text-sm"><%= link_to "Back to families", families_path, class: "text-blue-600 hover:underline" %></p>
</div>
