<% input_class = "block w-full rounded-md border border-gray-300 px-3 py-2" %>
<div class="mx-auto w-full max-w-md">
  <h2 class="mb-2 text-2xl font-bold">Reset your password</h2>
  <p class="mb-6 text-sm text-gray-600">
    Enter your family's username, or an adult's email or phone number. We'll email a reset link to the adults in your family.
    If no one in your family has an email address on file, ask a pack administrator to reset it.
  </p>

  <%= form_with(scope: :family, url: family_password_path, method: :post) do |f| %>
    <div class="mb-4">
      <%= f.label :login, "Username, phone, or email", class: "mb-1 block font-medium" %>
      <%= f.text_field :login, autofocus: true, class: input_class %>
    </div>

    <%= f.submit "Email me a reset link", class: "rounded-md bg-blue-600 px-4 py-2 font-medium text-white hover:bg-blue-500 cursor-pointer" %>
  <% end %>

  <p class="mt-6 text-sm"><%= link_to "Back to log in", new_family_session_path, class: "text-blue-600 hover:underline" %></p>
</div>
