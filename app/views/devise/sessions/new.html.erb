<% input_class = "block w-full rounded-md border border-gray-300 px-3 py-2" %>
<div class="mx-auto w-full max-w-md">
  <h2 class="mb-6 text-2xl font-bold">Log in</h2>

  <% families = Family.address_login_eligible.order(:name).pluck(:name, :id) %>
  <% if families.any? %>
    <%= form_with(scope: :address_sign_in, url: address_family_session_path) do |f| %>
      <div class="mb-4">
        <%= f.label :family_id, "Family", class: "mb-1 block font-medium" %>
        <%= f.select :family_id, options_for_select(families, @selected_family_id), { prompt: "Select your family" }, autofocus: true, class: input_class %>
      </div>

      <div class="mb-4">
        <%= f.label :street_address, class: "mb-1 block font-medium" do %>
          Confirm your street address
        <% end %>
        <p class="mb-1 text-sm text-gray-500">Do not include city, state, etc.</p>
        <%= f.text_field :street_address, autocomplete: "street-address", class: input_class %>
      </div>

      <%= f.submit "Log in with address", class: "rounded-md bg-blue-600 px-4 py-2 font-medium text-white hover:bg-blue-500 cursor-pointer" %>
    <% end %>

    <p class="my-6 text-center text-sm text-gray-500">or log in with a username and password</p>
  <% end %>

  <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
    <div class="mb-4">
      <%= f.label :username, class: "mb-1 block font-medium" %>
      <%= f.text_field :username, autofocus: families.empty?, autocomplete: "username", class: input_class %>
    </div>

    <div class="mb-4">
      <%= f.label :password, class: "mb-1 block font-medium" %>
      <%= f.password_field :password, autocomplete: "current-password", class: input_class %>
    </div>

    <% if devise_mapping.rememberable? %>
      <div class="mb-4 flex items-center gap-2">
        <%= f.check_box :remember_me %>
        <%= f.label :remember_me %>
      </div>
    <% end %>

    <%= f.submit "Log in", class: "rounded-md bg-blue-600 px-4 py-2 font-medium text-white hover:bg-blue-500 cursor-pointer" %>
  <% end %>
</div>
