<% input_class = "block w-full rounded-md border border-gray-300 px-3 py-2" %>
<div class="mx-auto w-full max-w-md">
  <h2 class="mb-6 text-2xl font-bold">Log in</h2>

  <section id="email_login">
    <h3 class="mb-1 font-semibold">Email me a sign-in code</h3>
    <p class="mb-3 text-sm text-gray-500">We'll email your family's adults a code and a link. Either one logs you in, no password needed.</p>
    <%= form_with(url: email_login_path) do |f| %>
      <div class="mb-4">
        <%= f.label :family_id, "Your family", class: "mb-1 block font-medium" %>
        <%= f.select :family_id, Family.email_login_eligible.order(:name).pluck(:name, :id), { prompt: "Select your family" }, autofocus: true, required: true, class: input_class %>
      </div>
      <%= f.submit "Email me a code", class: "rounded-md bg-blue-600 px-4 py-2 font-medium text-white hover:bg-blue-500 cursor-pointer" %>
    <% end %>
  </section>

  <p class="my-6 text-center text-sm text-gray-500">or log in with a password</p>

  <%= form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
    <div class="mb-4">
      <%= f.label :login, "Username, phone, or email", class: "mb-1 block font-medium" %>
      <%= f.text_field :login, class: input_class %>
    </div>

    <div class="mb-4">
      <%= f.label :password, class: "mb-1 block font-medium" %>
      <%= f.password_field :password, autocomplete: "current-password", class: input_class %>
    </div>

    <% if devise_mapping.rememberable? %>
      <div class="mb-4 flex items-center gap-2">
        <%= f.check_box :remember_me %>
        <%= f.label :remember_me %>
      </div>
    <% end %>

    <div class="flex flex-wrap items-center justify-between gap-4">
      <%= f.submit "Log in with password", class: "rounded-md bg-blue-600 px-4 py-2 font-medium text-white hover:bg-blue-500 cursor-pointer" %>
      <%= link_to "Forgot your password?", new_family_password_path, class: "text-sm text-blue-600 hover:underline" %>
    </div>
  <% end %>
</div>
