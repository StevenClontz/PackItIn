<div class="mt-6 space-y-1 text-sm">
  <%- if controller_name != 'sessions' %>
    <p><%= link_to "Log in", new_session_path(resource_name), class: "text-blue-600 hover:underline" %></p>
  <% end %>

  <%- if devise_mapping.registerable? && controller_name != 'registrations' %>
    <p><%= link_to "Sign up", new_registration_path(resource_name), class: "text-blue-600 hover:underline" %></p>
  <% end %>
</div>
