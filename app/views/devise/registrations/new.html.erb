<% input_class = "block w-full rounded-md border border-gray-300 px-3 py-2" %>
<div class="mx-auto w-full max-w-md">
  <h2 class="mb-6 text-2xl font-bold">Sign up</h2>

  <%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
    <%= render "devise/shared/error_messages", resource: resource %>

    <div class="mb-4">
      <%= f.label :username, class: "mb-1 block font-medium" %>
      <%= f.text_field :username, autofocus: true, autocomplete: "username", class: input_class %>
    </div>

    <%= render "families/address_fields", f: f %>

    <div class="mb-4">
      <%= f.label :password, class: "mb-1 block font-medium" %>
      <%= f.password_field :password, autocomplete: "new-password", class: input_class %>
      <% if @minimum_password_length %>
        <p class="mt-1 text-sm text-gray-500"><%= @minimum_password_length %> characters minimum</p>
      <% end %>
    </div>

    <div class="mb-4">
      <%= f.label :password_confirmation, class: "mb-1 block font-medium" %>
      <%= f.password_field :password_confirmation, autocomplete: "new-password", class: input_class %>
    </div>

    <%= f.submit "Sign up", class: "rounded-md bg-blue-600 px-4 py-2 font-medium text-white hover:bg-blue-500 cursor-pointer" %>
  <% end %>

  <%= render "devise/shared/links" %>
</div>
