<div class="mx-auto w-full max-w-2xl">
  <div class="mb-6 flex items-center justify-between">
    <h2 class="text-2xl font-bold">Events</h2>
    <% if can? :create, Event %>
      <%= link_to "New event", new_event_path, class: "rounded-md bg-blue-600 px-4 py-2 font-medium text-white hover:bg-blue-500" %>
    <% end %>
  </div>

  <% { "Upcoming" => @upcoming, "Past" => @past }.each do |heading, events| %>
    <h3 class="mb-2 mt-6 text-lg font-semibold"><%= heading %></h3>
    <% if events.empty? %>
      <p class="text-gray-700">No <%= heading.downcase %> events.</p>
    <% else %>
      <ul class="divide-y divide-gray-200 rounded-md border border-gray-200">
        <% events.each do |event| %>
          <li class="flex flex-wrap items-center justify-between gap-2 px-4 py-3">
            <span>
              <%= link_to event.title, event_path(event), class: "font-medium text-blue-600 hover:underline" %>
              <span class="block text-sm text-gray-500"><%= event_time_range(event) %></span>
            </span>
            <span class="flex items-center gap-4 text-sm">
              <% if can? :update, event %>
                <%= link_to "Edit", edit_event_path(event), class: "text-blue-600 hover:underline" %>
              <% end %>
              <% if can? :destroy, event %>
                <%= button_to "Delete", event_path(event), method: :delete, data: { turbo_confirm: "Delete #{event.title}? This also deletes its RSVPs." }, class: "text-red-600 hover:underline cursor-pointer" %>
              <% end %>
            </span>
          </li>
        <% end %>
      </ul>
    <% end %>
  <% end %>

  <p class="mt-6 text-sm"><%= link_to "Back", root_path, class: "text-blue-600 hover:underline" %></p>
</div>
