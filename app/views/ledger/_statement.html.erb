<% lines = lines.to_a %>
<% counterparty = Ledger.counterparty_namer(lines) %>

<% if lines.empty? %>
  <p class="text-gray-700">No activity yet.</p>
<% else %>
  <div class="overflow-x-auto rounded-md border border-gray-200">
    <table class="w-full text-left text-sm">
      <thead class="bg-gray-50 text-gray-700">
        <tr>
          <th class="px-4 py-2 font-medium">Date</th>
          <th class="px-4 py-2 font-medium">Description</th>
          <th class="px-4 py-2 text-right font-medium">Amount</th>
          <th class="px-4 py-2 text-right font-medium">Balance</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-gray-200">
        <% lines.each do |line| %>
          <% memo = line.metadata&.dig("memo") %>
          <tr>
            <td class="whitespace-nowrap px-4 py-2"><%= format_ledger_time(line.created_at) %></td>
            <td class="px-4 py-2">
              <%= t("ledger.codes.#{line.code}") %>
              <% if %i[transfer payment].include?(line.code) %>
                <%= line.amount.positive? ? "from" : "to" %> <%= counterparty.call(line) %>
              <% end %>
              <% if memo.present? %>
                <span class="block text-gray-500"><%= memo %></span>
              <% end %>
            </td>
            <td class="whitespace-nowrap px-4 py-2 text-right"><%= money(line.amount) %></td>
            <td class="whitespace-nowrap px-4 py-2 text-right"><%= money(line.balance) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <% if lines.size >= AccountsController::STATEMENT_LINES %>
    <p class="mt-2 text-sm text-gray-500">Showing the latest <%= AccountsController::STATEMENT_LINES %> transactions.</p>
  <% end %>
<% end %>
