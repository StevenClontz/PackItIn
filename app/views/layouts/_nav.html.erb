<header class="border-b border-gray-200" data-controller="nav">
  <nav class="container mx-auto flex items-center justify-between gap-4 px-5 py-4">
    <%= link_to app_name, root_path, class: "font-bold text-lg text-gray-900" %>

    <div class="hidden items-center gap-4 md:flex">
      <%= render "layouts/nav_links" %>
    </div>

    <button
      type="button"
      class="md:hidden"
      data-nav-target="button"
      data-action="nav#toggle"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Menu"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </nav>

  <div id="mobile-menu" class="hidden md:hidden" data-nav-target="menu">
    <div class="flex flex-col items-start gap-2 px-5 pb-4">
      <%= render "layouts/nav_links" %>
    </div>
  </div>
</header>
